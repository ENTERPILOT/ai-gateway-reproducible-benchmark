# How the harness talks to LLMGateway. Sourced by run-on-instance.sh.
IMAGE=ghcr.io/theopenco/llmgateway-gateway:latest   # default image; override with LLMGATEWAY_IMAGE
PORT=4001
MODEL=gpt-4o-mini
MESSAGES_PATH=/v1/messages
# Fail on the first upstream error instead of falling back: parity with no-retry peers.
HEADERS=("x-no-fallback: true")
# Migrations ship in the API image, so it follows the gateway's tag. A digest pin of the
# gateway needs its own LLMGATEWAY_API_IMAGE.
_gw_image="${LLMGATEWAY_IMAGE:-$IMAGE}"
export LLMGATEWAY_API_IMAGE="${LLMGATEWAY_API_IMAGE:-${_gw_image/llmgateway-gateway/llmgateway-api}}"
# Required companions: they start and stop with the gateway, and their RAM, CPU and image
# size count towards its row. They never run while another gateway is being measured.
SIDECARS=(llmgateway-postgres llmgateway-redis llmgateway-init)
