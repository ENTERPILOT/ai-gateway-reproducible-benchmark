# How the harness talks to TensorZero. Sourced by run-on-instance.sh.
IMAGE=tensorzero/gateway:latest             # default image; override with TENSORZERO_IMAGE
PORT=3000
MODEL=tensorzero::model_name::gpt-4o-mini   # the [models.gpt-4o-mini] entry in tensorzero.toml
CHAT_PATH=/openai/v1/chat/completions       # OpenAI-compatible surface lives under /openai
# TensorZero exposes no client-facing Responses or Anthropic Messages endpoint (only its
# native /inference plus /openai/v1/chat/completions); those variants are reported as failures.
RESPONSES_PATH=/openai/v1/responses
MESSAGES_PATH=/anthropic/v1/messages
HEADERS=()
