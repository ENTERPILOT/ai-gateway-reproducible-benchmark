# How the harness talks to Kaeso. Sourced by run-on-instance.sh.
IMAGE=ghcr.io/logicplanes/kaeso-gateway:0.7   # newest 0.7.x release (Kaeso publishes no :latest); override with KAESO_IMAGE
PORT=8080
MODEL=gpt-4o-mini
# Kaeso only accepts its own key format (sk-kso- and 48 letters or digits), so the harness's
# shared key can't be used. kaeso-init creates this one; it is a bench-only value.
AUTH=sk-kso-benchtestkeybenchtestkeybenchtestkeybenchtestkey
export KAESO_BENCH_KEY="$AUTH"
HEADERS=()
# Required companions: they start and stop with the gateway, and their RAM, CPU and image
# size count towards its row. They never run while another gateway is being measured.
SIDECARS=(kaeso-postgres kaeso-valkey kaeso-init)
# One-shot sidecars the harness waits for before it probes. kaeso-init needs the running
# gateway, so it can't finish before Kaeso starts (unlike LLMGateway's seeding), and a probe
# with a key that doesn't exist yet would be cached as unknown for 30 s. Its runtime still
# counts towards cold start.
ONESHOTS=(kaeso-init)
