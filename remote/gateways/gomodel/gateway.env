# How the harness talks to GoModel. Sourced by run-on-instance.sh.
IMAGE=enterpilot/gomodel:latest   # default image; override with GOMODEL_IMAGE
PORT=8080                         # port the container listens on
MODEL=gpt-4o-mini                 # model name to request
MESSAGES_PATH=/v1/messages        # where the Anthropic Messages dialect is served
HEADERS=()                        # extra request headers, "Name: value" each
