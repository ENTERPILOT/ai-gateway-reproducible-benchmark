# How the harness talks to Bifrost. Sourced by run-on-instance.sh.
IMAGE=maximhq/bifrost:latest          # default image; override with BIFROST_IMAGE
PORT=8089
MODEL=openai/gpt-4o-mini              # Bifrost routes by an explicit provider/model prefix
MESSAGES_PATH=/anthropic/v1/messages  # Anthropic Messages dialect lives under /anthropic
HEADERS=()
