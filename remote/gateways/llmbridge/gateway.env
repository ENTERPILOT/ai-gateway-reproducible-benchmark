# How the harness talks to llmbridge. Sourced by run-on-instance.sh.
IMAGE=ghcr.io/kottos-ai/llmbridge:latest   # default image; override with LLMBRIDGE_IMAGE
PORT=8092                                 # port the container listens on
MODEL=gpt-4o-mini                         # model name to request
MESSAGES_PATH=/v1/messages                # refused: no Anthropic-to-OpenAI translation; reported as failures
HEADERS=()                                # extra request headers, "Name: value" each
