# How the harness talks to Portkey. Sourced by run-on-instance.sh.
IMAGE=portkeyai/gateway:latest   # default image; override with PORTKEY_IMAGE
PORT=8787
MODEL=gpt-4o-mini
MESSAGES_PATH=/v1/messages       # not served in this single-provider setup; reported as failures
# Portkey routes per request: provider + custom upstream host (the mock).
HEADERS=("x-portkey-provider: openai" "x-portkey-custom-host: http://mock:9999/v1")
